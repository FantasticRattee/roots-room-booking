<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Views: the screens of a booking (list, form, calendar, search bar). -->
    <!-- ============================= Views ============================= -->
    <!-- List of bookings (the first screen people see) -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~ List View ~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <record id="booking_booking_view_list" model="ir.ui.view">
        <field name="name">booking.booking.list</field>
        <field name="model">booking.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="resource_id"/>
                <field name="user_id"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'requested'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state in ('completed', 'cancelled')"/>
            </list>
        </field>
    </record>
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~ End List View ~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <!-- Form to create or edit one booking -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~ Form View ~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <record id="booking_booking_view_form" model="ir.ui.view">
        <field name="name">booking.booking.form</field>
        <field name="model">booking.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- R4: type="object" runs the Python method of this name. groups / invisible
                         only hide a button (not id = not saved yet); write() enforces the rules. -->
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" groups="room_booking.group_booking_manager"
                            invisible="not id or state != 'requested'"/>
                    <!-- Cancel: managers see it on every booking, employees only on their own -->
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="room_booking.group_booking_manager"
                            invisible="not id or state not in ('requested', 'confirmed')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="!room_booking.group_booking_manager"
                            invisible="not id or state not in ('requested', 'confirmed') or user_id != uid"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,confirmed,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Team meeting"/></h1>
                    </div>
                    <group>
                        <group>
                            <!-- New booking: pick a room, an equipment or both. Saved booking: one resource. -->
                            <field name="room_id" invisible="id"/>
                            <field name="equipment_id" invisible="id"/>
                            <field name="resource_id" invisible="not id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="start"/>
                            <field name="stop"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~ End Form View ~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <!-- Calendar of bookings, one colour per resource -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~ Calendar View ~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <record id="booking_booking_view_calendar" model="ir.ui.view">
        <field name="name">booking.booking.calendar</field>
        <field name="model">booking.booking</field>
        <field name="arch" type="xml">
            <calendar date_start="start" date_stop="stop"
                      color="resource_id" mode="week" quick_create="0">
                <field name="resource_id"/>
                <field name="user_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~ End Calendar View ~~~~~~~~~~~~~~~~~~~~~~~ -->

    <!-- Search bar: filters and grouping -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~ Search View ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <record id="booking_booking_view_search" model="ir.ui.view">
        <field name="name">booking.booking.search</field>
        <field name="model">booking.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="resource_id"/>
                <field name="user_id"/>
                <filter name="my_bookings" string="My Bookings"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="to_approve" string="To Approve"
                        domain="[('state', '=', 'requested')]"/>
                <filter name="group_resource" string="Resource"
                        context="{'group_by': 'resource_id'}"/>
                <separator/>
                <filter name="rooms" string="Rooms"
                        domain="[('resource_id.resource_type', '=', 'room')]"/>
                <filter name="equipment" string="Equipment"
                        domain="[('resource_id.resource_type', '=', 'equipment')]"/>
            </search>
        </field>
    </record>
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~ End Search View ~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!-- =========================== End Views =========================== -->

    <!-- What the Bookings menu opens: list first, then calendar and form -->
    <!-- ============================ Action ============================= -->
    <record id="booking_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">booking.booking</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book your first room or equipment</p>
        </field>
    </record>
    <!-- Menu Room Booking > Rooms: the same bookings, with the Rooms filter already on -->
    <record id="booking_room_action" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">booking.booking</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_rooms': 1}</field>
    </record>
    <!-- Menu Room Booking > Equipment: the same bookings, with the Equipment filter already on -->
    <record id="booking_equipment_action" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">booking.booking</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_equipment': 1}</field>
    </record>
    <!-- ========================== End Action =========================== -->
</odoo>
